<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Events"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0B6B3A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Events you have registered for"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />


        <!-- Registered Event Card -->

        <androidx.cardview.widget.CardView
            android:id="@+id/eventCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:visibility="gone"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Event Name -->

                <TextView
                    android:id="@+id/txtMyEventName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Event Name"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <!-- Date -->

                <TextView
                    android:id="@+id/txtMyEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="📅 Date"
                    android:textSize="15sp"
                    android:textColor="#555555" />

                <!-- Location -->

                <TextView
                    android:id="@+id/txtMyEventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="📍 Location"
                    android:textSize="15sp"
                    android:textColor="#555555" />

                <!-- Registration Status -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="✓ Registered"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0B6B3A" />

                <!-- Cancel Button -->

                <Button
                    android:id="@+id/btnCancelEvent"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="18dp"
                    android:text="CANCEL REGISTRATION"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- No Events -->

        <TextView
            android:id="@+id/txtNoEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:text="You have not registered for any events yet."
            android:textSize="16sp"
            android:textColor="#777777" />

    </LinearLayout>

</ScrollView>