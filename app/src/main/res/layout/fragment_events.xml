<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore Events"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#0B6B3A" />

        <!-- Subtitle -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Find events that interest you"
            android:textSize="15sp"
            android:textColor="#666666" />


        <!-- Search -->

        <EditText
            android:id="@+id/edtEventSearch"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:hint="Search events..."
            android:padding="14dp" />


        <!-- Create Event Button -->

        <Button
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:text="CREATE EVENT"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B6B3A" />


        <!-- Categories -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Categories"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- University -->

                <Button
                    android:id="@+id/btnUniversity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="University" />

                <!-- Sports -->

                <Button
                    android:id="@+id/btnSports"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Sports" />

                <!-- Business -->

                <Button
                    android:id="@+id/btnBusiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Business" />

                <!-- Concerts -->

                <Button
                    android:id="@+id/btnConcerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Concerts" />

                <!-- Weddings -->

                <Button
                    android:id="@+id/btnWeddings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Weddings" />

            </LinearLayout>

        </HorizontalScrollView>


        <!-- All Events -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="All Events"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222" />


        <!-- Static Tech Innovation Summit -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tech Innovation Summit"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="📅 12 September 2026"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="📍 Lahore"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnEventDetails"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="15dp"
                    android:text="VIEW DETAILS"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#0B6B3A" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Dynamic SQLite Events -->

        <LinearLayout
            android:id="@+id/eventsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>