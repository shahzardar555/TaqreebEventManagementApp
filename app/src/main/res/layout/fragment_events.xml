<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore Events"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0B6B3A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find events that interest you"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />


        <!-- Search -->

        <EditText
            android:id="@+id/edtEventSearch"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:hint="Search events..."
            android:padding="14dp"
            android:background="@android:drawable/editbox_background" />


        <!-- Create Event -->

        <Button
            android:id="@+id/btnAddEvent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="CREATE EVENT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#0B6B3A" />


        <!-- Categories -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categories"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="28dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAllEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="All Events" />

                <Button
                    android:id="@+id/btnUniversity"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="University" />

                <Button
                    android:id="@+id/btnSports"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="Sports" />

                <Button
                    android:id="@+id/btnBusiness"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="Business" />

                <Button
                    android:id="@+id/btnConcerts"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="Concerts" />

                <Button
                    android:id="@+id/btnWeddings"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:text="Weddings" />

            </LinearLayout>

        </HorizontalScrollView>


        <!-- Events Heading -->

        <TextView
            android:id="@+id/txtEventsHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Events"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:layout_marginTop="28dp" />


        <!-- Static Event -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tech Innovation Summit"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 12 September 2026"
                    android:textSize="15sp"
                    android:textColor="#555555"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Lahore"
                    android:textSize="15sp"
                    android:textColor="#555555"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 Technology &amp; Innovation"
                    android:textSize="15sp"
                    android:textColor="#555555"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnEventDetails"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="VIEW DETAILS"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#0B6B3A"
                    android:layout_marginTop="18dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Dynamic SQLite Events -->

        <LinearLayout
            android:id="@+id/eventsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />


        <!-- No Events Message -->

        <TextView
            android:id="@+id/txtNoEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="No events found in this category."
            android:textSize="16sp"
            android:textColor="#777777"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>