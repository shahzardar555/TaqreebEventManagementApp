<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">


        <!-- Page Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#0B6B3A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage your Taqreeb account"
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />


        <!-- Profile Card -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="25dp"
                android:background="#FFFFFF">


                <!-- Profile Picture Circle -->

                <androidx.cardview.widget.CardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardBackgroundColor="#0B6B3A"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="3dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="#E8F5EE"
                        app:cardCornerRadius="56dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imgProfile"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@android:drawable/ic_menu_camera"
                            android:scaleType="centerCrop"
                            android:padding="22dp"
                            android:contentDescription="Profile Picture" />

                    </androidx.cardview.widget.CardView>

                </androidx.cardview.widget.CardView>


                <!-- Change Photo Button -->

                <Button
                    android:id="@+id/btnChangePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="45dp"
                    android:text="CHANGE PHOTO"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0B6B3A"
                    android:backgroundTint="#E8F5EE"
                    android:layout_marginTop="14dp" />


                <!-- User Name -->

                <TextView
                    android:id="@+id/txtProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="18dp" />


                <!-- User Email -->

                <TextView
                    android:id="@+id/txtProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No email"
                    android:textSize="15sp"
                    android:textColor="#666666"
                    android:layout_marginTop="5dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Edit Profile -->

        <Button
            android:id="@+id/btnEditProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:text="EDIT PROFILE"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B6B3A" />


        <!-- Share Taqreeb -->

        <Button
            android:id="@+id/btnShareTaqreeb"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="SHARE TAQREEB"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B6B3A" />


        <!-- Logout -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="LOGOUT"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>