<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Heading -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Details"
            android:textColor="#0B6B3A"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- Event Card -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="#FFFFFF">

                <!-- Event Name -->

                <TextView
                    android:id="@+id/txtEventName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tech Innovation Summit"
                    android:textColor="#222222"
                    android:textSize="25sp"
                    android:textStyle="bold" />


                <!-- Date -->

                <TextView
                    android:id="@+id/txtEventDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 12 September 2026"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:layout_marginTop="18dp" />


                <!-- Location -->

                <TextView
                    android:id="@+id/txtEventLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 Lahore"
                    android:textSize="16sp"
                    android:textColor="#555555"
                    android:layout_marginTop="8dp" />


                <!-- Category -->

                <TextView
                    android:id="@+id/txtEventCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Technology • University"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0B6B3A"
                    android:layout_marginTop="8dp" />


                <!-- Description -->

                <TextView
                    android:id="@+id/txtEventDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Join students, developers and technology enthusiasts for an exciting day of innovation, networking and learning."
                    android:textSize="16sp"
                    android:textColor="#444444"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginTop="25dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- Register -->

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="REGISTER NOW"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#0B6B3A"
            android:layout_marginTop="25dp" />


        <!-- View Location -->

        <Button
            android:id="@+id/btnViewLocation"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VIEW LOCATION"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B6B3A"
            android:layout_marginTop="10dp" />


        <!-- Call Organizer -->

        <Button
            android:id="@+id/btnCallOrganizer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CALL ORGANIZER"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0B6B3A"
            android:layout_marginTop="10dp" />


        <!-- Back -->

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="BACK TO EVENTS"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>