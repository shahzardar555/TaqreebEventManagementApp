<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Name -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Taqreeb.pk"
            android:textColor="#0B6B3A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Har Taqreeb, Ek Jagah."
            android:textColor="#666666"
            android:textSize="15sp"
            android:layout_marginTop="3dp" />


        <!-- Welcome -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find your next event 👋"
            android:textColor="#222222"
            android:textSize="23sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discover events happening around you."
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />


        <!-- Search Bar -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Search events..."
                android:padding="14dp"
                android:background="@android:drawable/editbox_background" />

            <Button
                android:id="@+id/btnSearch"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="SEARCH"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0B6B3A"
                android:layout_marginStart="8dp" />

        </LinearLayout>


        <!-- Upcoming Events -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upcoming Events"
            android:textColor="#222222"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp" />


        <!-- Event Card -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tech Innovation Summit"
                    android:textColor="#222222"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅 12 September 2026"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Lahore"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💻 Technology &amp; Innovation"
                    android:textColor="#555555"
                    android:textSize="15sp"
                    android:layout_marginTop="6dp" />

                <Button
                    android:id="@+id/btnViewEvent"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="VIEW EVENT"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:backgroundTint="#0B6B3A"
                    android:layout_marginTop="18dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>